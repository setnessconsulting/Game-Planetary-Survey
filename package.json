{
  "name": "game-planetary-survey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planetary Survey — standalone browser-first middle-school planetary-science game (GAME-362 / GAME-364).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:nested": "vite build --base=/game-assets/planetary-survey/0.1.0/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test --config=playwright.config.ts",
    "test:a11y:run": "playwright test --config=playwright.config.ts --grep @a11y",
    "serve:nested-host": "node scripts/nested-host-server.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:privacy": "node scripts/check-privacy-surface.mjs",
    "check:assets": "node scripts/check-asset-pipeline.mjs",
    "report:bundle": "node scripts/report-bundle-size.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs dist",
    "release:check": "node scripts/create-release-manifest.mjs dist --check",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run check:architecture && npm run check:privacy && npm run check:assets && npm run build"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
